516","fix":"517"},"Update the dependencies array to be: [getDepartment]",{"range":"518","text":"519"},"Update the dependencies array to be: [getUser]",{"range":"520","text":"521"},"Update the dependencies array to be: [getDepartments]",{"range":"522","text":"523"},"Update the dependencies array to be: [loadDefaultValue]",{"range":"524","text":"525"},"Update the dependencies array to be: [logUserOut]",{"range":"526","text":"527"},"Update the dependencies array to be: [getCategory]",{"range":"528","text":"529"},"Update the dependencies array to be: [getCourse]",{"range":"530","text":"531"},"Update the dependencies array to be: [getCategories]",{"range":"532","text":"533"},"Update the dependencies array to be: [getLectures, refresh]",{"range":"534","text":"535"},"Update the dependencies array to be: [getLecture]",{"range":"536","text":"537"},"Update the dependencies array to be: [getData]",{"range":"538","text":"539"},[1184,1186],"[getDepartment]",[1130,1132],"[getUser]",[2618,2620],"[getDepartments]",[893,895],"[loadDefaultValue]",[909,911],"[logUserOut]",[1167,1169],"[getCategory]",[1148,1150],"[getCourse]",[2597,2599],"[getCategories]",[750,759],"[getLectures, refresh]",[1213,1215],"[getLecture]",[695,697],"[getData]"]