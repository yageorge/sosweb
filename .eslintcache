ate the dependencies array to be: [logUserOut]",{"range":"567","text":"568"},"Update the dependencies array to be: [getCategory]",{"range":"569","text":"570"},"Update the dependencies array to be: [getCourse]",{"range":"571","text":"572"},"Update the dependencies array to be: [getCategories]",{"range":"573","text":"574"},"Update the dependencies array to be: [getLectures, refresh]",{"range":"575","text":"576"},"Update the dependencies array to be: [getLecture]",{"range":"577","text":"578"},"Update the dependencies array to be: [getData]",{"range":"579","text":"580"},[974,976],"[getStatsData]",[1192,1194],"[getDepartment]",[1138,1140],"[getUser]",[2595,2597],"[getDepartments]",[893,895],"[loadDefaultValue]",[1217,1219],"[logUserOut]",[1175,1177],"[getCategory]",[1156,1158],"[getCourse]",[2562,2564],"[getCategories]",[815,824],"[getLectures, refresh]",[1221,1223],"[getLecture]",[766,768],"[getData]"]