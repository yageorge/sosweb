OptimizerSolution\\sosweb\\src\\components\\cards\\courses\\view\\components\\TableBody.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\courses\\view\\components\\TableRow.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\categories\\common\\SelectCategory.js",["439"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\common\\TextArea.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\lectures\\IndexLectures.js",["440"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\lectures\\view\\Lectures.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Lectures.js",["441"],"import axios from 'axios';\r\n\r\nexport default {\r\n    getLectures: (course_id) =>\r\n        axios.get(`/lectures`, { params: { \"course_id\": course_id } }),\r\n\r\n    addLecture: (lecture) =>\r\n        axios.post(`/lectures/`, lecture),\r\n\r\n    editLecture: (id) =>\r\n        axios.get(`/lectures/${id}/edit`),\r\n\r\n    updateLecture: (lecture, id) =>\r\n        axios.put(`/lectures/${id}`, lecture),\r\n\r\n    deleteLecture: (id) =>\r\n        axios.delete(`/lectures/${id}`),\r\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\lectures\\view\\components\\Panel.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\lectures\\CreateLecture.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\lectures\\EditLecture.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\lectures\\form\\Edit.js",["442","443"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\lectures\\form\\Create.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\lectures\\form\\components\\Form.js",["444"],"import React, { useState } from 'react';\r\n\r\nimport UserInput from \"../../../common/UserInput\"\r\nimport TextArea from \"../../../common/TextArea\"\r\n\r\nexport default function Forum(props) {\r\n\r\n  const lecture = props.lecture\r\n\r\n  // Rendering table\r\n  return (\r\n    <div className=\"flex-auto px-4 lg:px-10 py-10 pt-0\">\r\n      <form id=\"lecture_form\" onSubmit={props.submitFunction}>\r\n\r\n        {/* Title Input */}\r\n        <UserInput\r\n          inputId=\"title\"\r\n          inputName=\"Title\"\r\n          inputType=\"text\"\r\n          defaultValue={lecture ? lecture.title : \"\"}\r\n          maxLength=\"64\"\r\n          onChange={props.onChange}\r\n        />\r\n\r\n        {/* Total Duration Input */}\r\n        <UserInput\r\n          inputId=\"duration\"\r\n          inputName=\"Total Duration (min)\"\r\n          inputType=\"number\"\r\n          defaultValue={lecture ? lecture.duration : \"\"}\r\n          max=\"9999\"\r\n          onChange={props.onChange}\r\n        />\r\n\r\n        {/* User Video URL Input */}\r\n        < UserInput\r\n          inputId=\"urlVideo\"\r\n          inputName=\"Video URL\"\r\n          inputType=\"url\"\r\n          defaultValue={lecture ? lecture.urlVideo : \"\"}\r\n          maxLength=\"64\"\r\n          onChange={props.onChange}\r\n        />\r\n\r\n        {/* User Content Input */}\r\n        < TextArea\r\n          inputId=\"content\"\r\n          inputName=\"Content\"\r\n          defaultValue={lecture ? lecture.content : \"\"}\r\n          onChange={props.onChange}\r\n          rows={26}\r\n        />\r\n\r\n        {/* Submit form Button */}\r\n        <div className=\"text-center mt-6\">\r\n          <button\r\n            className=\"bg-gray-900 text-white active:bg-gray-700 text-sm font-bold uppercase px-6 py-3 rounded shadow hover:shadow-lg outline-none focus:outline-none mr-1 mb-1 w-full ease-linear transition-all duration-150\"\r\n            type=\"submit\"\r\n            form=\"lecture_form\"\r\n          >\r\n            {props.action}\r\n          </button>\r\n        </div>\r\n\r\n      </form>\r\n    </div>\r\n  );\r\n};","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\Test.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\allocations\\indexAllocations.js",["445"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\allocations\\view\\Allocations.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\allocations\\view\\components\\departments\\DepartmentsCard.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\allocations\\view\\components\\courses\\CoursesCard.js",["446"],"import React, { useState } from \"react\"\r\n\r\nimport LoadingSpinner from \"../../../../../spinner/LoadingSpinner\"\r\nimport SearchBar from \"../../../../../searchbar/SearchBar\"\r\n\r\n\r\nexport default function CoursesCard(props) {\r\n\r\n  const loading = props.loading\r\n  const courses = props.courses\r\n  const [openTab, setOpenTab] = useState(0)\r\n  const [searchInput, setSearchInput] = useState('')\r\n\r\n  const onButtonClick = async (event, courseId) => {\r\n    event.preventDefault();\r\n\r\n    // Setting courseId as current selected Tab\r\n    setOpenTab(courseId);\r\n\r\n    // Function run to Allocate or Remove Allocation\r\n    props.onClick(courseId)\r\n\r\n    // Clearing user search input\r\n    setSearchInput('')\r\n\r\n  }\r\n\r\n  // On user search event\r\n  const onSearch = (event) => {\r\n    setSearchInput(event.target.value)\r\n  }\r\n\r\n  const renderCourses = () => {\r\n\r\n    return (\r\n\r\n      <ul\r\n        className=\"grid grid-cols-2 gap-4 pb-6\"\r\n        role=\"tablist\"\r\n      >\r\n\r\n        {courses.filter(\r\n          // Filter courses by user Search Input\r\n          course => course.title.toLowerCase().includes(searchInput.toLowerCase()))\r\n\r\n          .map((course) => (\r\n\r\n            <li className=\"text-center\">\r\n\r\n              <a\r\n                className={\r\n                  \"text-xs font-bold uppercase px-5 py-3 shadow-lg rounded-xl border-2 border-teal-500 block leading-normal transform hover:scale-105 hover:bg-teal-100 text-teal-900 bg-white\"\r\n                }\r\n                onClick={event => {\r\n                  onButtonClick(event, course.id)\r\n                }}\r\n                data-toggle=\"tab\"\r\n                href=\"#link1\"\r\n                role=\"tablist\"\r\n              >\r\n                {course.title}\r\n              </a>\r\n\r\n            </li>\r\n\r\n          ))}\r\n\r\n      </ul>\r\n\r\n    )\r\n  }\r\n\r\n  // Rendering table\r\n  return (\r\n\r\n    <div className=\"flex flex-col w-2/4\">\r\n\r\n      <p className=\"rounded-t-lg bg-gray-700 mx-4 p-4 text-center text-md font-bold text-teal-100\">\r\n        {props.title}\r\n      </p>\r\n\r\n\r\n      <div className=\"rounded-b-lg bg-gray-700 mx-4 mb-4 px-4\">\r\n\r\n        { // If not loading show courses\r\n          !loading ?\r\n            // If Courses available, render courses\r\n            courses ?\r\n              <div>\r\n\r\n                {/* User input search bar */}\r\n                <div className=\"mb-6\">\r\n                  <SearchBar\r\n                    className=\"flex flex-row relative\"\r\n                    onChange={onSearch}\r\n                  />\r\n                </div>\r\n\r\n\r\n                {/* Departments data rendering */}\r\n                {renderCourses()}\r\n\r\n              </div>\r\n              :\r\n              // If Courses not available\r\n              <div className=\"text-center text-sm text-white m-6\">\r\n                No courses\r\n            </div>\r\n            // If loading show LoadingSpinner\r\n            : <LoadingSpinner />\r\n        }\r\n      </div>\r\n    </div>\r\n\r\n  );\r\n};\r\n","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\spinner\\LoadingSpinner.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Allocations.js",["447"],"import axios from 'axios';\r\n\r\nexport default {\r\n\r\n    // Get all courses Allocated to department ID\r\n    getAllocations: (departmentId) =>\r\n        axios.get(`/allocations/${departmentId}`),\r\n\r\n    // Get all courses Un-Allocated to department ID\r\n    getUnAllocated: (departmentId) =>\r\n        axios.get(`/allocations/${departmentId}/unallocated`),\r\n\r\n    addAllocation: (allocation) =>\r\n        axios.post(`/allocations/`, allocation),\r\n\r\n    deleteAllocation: (allocation) =>\r\n        axios.delete(`/allocations/`, { data: allocation })\r\n\r\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\searchbar\\SearchBar.js",[],{"ruleId":"448","replacedBy":"449"},{"ruleId":"450","replacedBy":"451"},{"ruleId":"452","severity":1,"message":"453","line":13,"column":19,"nodeType":"454","messageId":"455","endLine":13,"endColumn":28},{"ruleId":"452","severity":1,"message":"456","line":13,"column":30,"nodeType":"454","messageId":"455","endLine":13,"endColumn":42},{"ruleId":"457","severity":1,"message":"458","line":34,"column":19,"nodeType":"459","endLine":34,"endColumn":34},{"ruleId":"457","severity":1,"message":"458","line":45,"column":19,"nodeType":"459","endLine":45,"endColumn":34},{"ruleId":"457","severity":1,"message":"458","line":34,"column":19,"nodeType":"459","endLine":34,"endColumn":34},{"ruleId":"457","severity":1,"message":"458","line":45,"column":19,"nodeType":"459","endLine":45,"endColumn":34},{"ruleId":"452","severity":1,"message":"460","line":18,"column":10,"nodeType":"454","messageId":"455","endLine":18,"endColumn":17},{"ruleId":"452","severity":1,"message":"456","line":18,"column":30,"nodeType":"454","messageId":"455","endLine":18,"endColumn":42},{"ruleId":"452","severity":1,"message":"460","line":18,"column":10,"nodeType":"454","messageId":"455","endLine":18,"endColumn":17},{"ruleId":"452","severity":1,"message":"456","line":18,"column":30,"nodeType":"454","messageId":"455","endLine":18,"endColumn":42},{"ruleId":"461","severity":1,"message":"462","line":22,"column":1,"nodeType":"463","endLine":42,"endColumn":2},{"ruleId":"461","severity":1,"message":"462","l