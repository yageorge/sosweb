default function Navbar() {\n  return (\n    <>\n      <nav className=\"top-0 absolute z-50 w-full flex flex-wrap items-center justify-between px-2 py-3 navbar-expand-lg\">\n        <div className=\"container px-4 mx-auto flex flex-wrap items-center justify-between\">\n\n          {/* Name + Route to Home */}\n          <div className=\"w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n            <Link\n              className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n              to=\"/\"\n            >\n              Skill Optimizer\n            </Link>\n          </div>\n\n          {/* Social Logos + Login / Register Buttons */}\n          <div\n            className={\n              \"lg:flex flex-grow items-center bg-white lg:bg-transparent lg:shadow-none block rounded shadow-lg\"\n            }\n            id=\"example-navbar-warning\"\n          >\n            <ul className=\"flex flex-row list-none ml-auto\">\n\n              {/* Facebook Logo: */}\n              <li>\n                <a\n                  className=\"px-3 py-2 flex items-center\"\n                  href=\"https://www.facebook.com/\"\n                  target=\"_blank\"\n                >\n                  <i className=\"text-gray-300 fab fa-facebook text-lg leading-lg \" />\n                </a>\n              </li>\n\n              {/* Twitter Logo: */}\n              <li>\n                <a\n                  className=\"px-3 py-2 flex items-center\"\n                  href=\"https://twitter.com/\"\n                  target=\"_blank\"\n                >\n                  <i className=\"text-gray-300 fab fa-twitter text-lg leading-lg \" />\n                </a>\n              </li>\n\n              {/* Login Button: */}\n              <div className=\"pl-4 w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n                <Link\n                  className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n                  to=\"/auth\"\n                >\n                  Login\n                </Link>\n              </div>\n\n              {/* Register Button: */}\n              <div className=\"w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n                <Link\n                  className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n                  to=\"/auth/signup\"\n                >\n                  Signup\n                </Link>\n              </div>\n            </ul>\n          </div>\n        </div>\n      </nav>\n    </>\n  );\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\login\\Login.js",["118"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\signup\\SignUp.js",["119"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Api.js",["120"],"import axios from \"axios\";\r\nimport Auth from \"./Auth\";\r\n\r\naxios.defaults.baseURL = 'http://127.0.0.1:8000/api'\r\naxios.defaults.withCredentials = true\r\n\r\n//Adding Token to Header\r\nconst setToken = (token = null) => {\r\n    axios.defaults.headers = {\r\n        'Accept': 'application/json',\r\n        'Content-Type': 'application/json',\r\n        'Authorization': `Bearer ${token}`,\r\n    }\r\n}\r\n\r\nexport default {\r\n\r\n    // Initialize APIs axios\r\n    init: (token) => {\r\n        setToken(token)\r\n    },\r\n\r\n    auth: { ...Auth },\r\n\r\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Auth.js",["121"],"import axios from \"axios\"\r\n\r\nexport default {\r\n\r\n    login: async (credentials) => {\r\n        return await axios.post('/login', credentials).then(response => response.data)\r\n    },\r\n\r\n    signup: async (credentials) => {\r\n        return await axios.post('/signup', credentials).then(response => response.data)\