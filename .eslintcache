erSolution\\sosweb\\src\\index.js",[],["168","169"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\App.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\reportWebVitals.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\core\\AppRouter.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\landing\\Landing.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\Navbars\\AuthNavbar.js",["170","171"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\navbars\\AuthNavbar.js",["172","173"],"import React from \"react\";\nimport { Link } from \"react-router-dom\";\n\nexport default function Navbar() {\n  return (\n    <>\n      <nav className=\"top-0 absolute z-50 w-full flex flex-wrap items-center justify-between px-2 py-3 navbar-expand-lg\">\n        <div className=\"container px-4 mx-auto flex flex-wrap items-center justify-between\">\n\n          {/* Name + Route to Home */}\n          <div className=\"w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n            <Link\n              className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n              to=\"/\"\n            >\n              Skill Optimizer\n            </Link>\n          </div>\n\n          {/* Social Logos + Login / Register Buttons */}\n          <div\n            className={\n              \"lg:flex flex-grow items-center bg-white lg:bg-transparent lg:shadow-none block rounded shadow-lg\"\n            }\n            id=\"example-navbar-warning\"\n          >\n            <ul className=\"flex flex-row list-none ml-auto\">\n\n              {/* Facebook Logo: */}\n              <li>\n                <a\n                  className=\"px-3 py-2 flex items-center\"\n                  href=\"https://www.facebook.com/\"\n                  target=\"_blank\"\n                >\n                  <i className=\"text-gray-300 fab fa-facebook text-lg leading-lg \" />\n                </a>\n              </li>\n\n              {/* Twitter Logo: */}\n              <li>\n                <a\n                  className=\"px-3 py-2 flex items-center\"\n                  href=\"https://twitter.com/\"\n                  target=\"_blank\"\n                >\n                  <i className=\"text-gray-300 fab fa-twitter text-lg leading-lg \" />\n                </a>\n              </li>\n\n              {/* Login Button: */}\n              <div className=\"pl-4 w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n                <Link\n                  className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n                  to=\"/auth\"\n                >\n                  Login\n                </Link>\n              </div>\n\n              {/* Register Button: */}\n              <div className=\"w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n                <Link\n                  className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n                  to=\"/auth/signup\"\n                >\n                  Signup\n                </Link>\n              </div>\n            </ul>\n          </div>\n        </div>\n      </nav>\n    </>\n  );\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\login\\Login.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\signup\\SignUp.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Api.js",["174"],"import axios from \"axios\";\r\nimport Auth from \"./Auth\";\r\nimport Departments from \"./Departments\";\r\n\r\naxios.defaults.baseURL = 'http://127.0.0.1:8000/api'\r\naxios.defaults.withCredentials = true\r\n\r\n//Adding Token to Header\r\nconst setToken = (token = null) => {\r\n    axios.defaults.headers = {\r\n        'Accept': 'application/json',\r\n        'Content-Type': 'application/json',\r\n        'Authorization': `Bearer ${token}`,\r\n    }\r\n}\r\n\r\nexport default {\r\n\r\n    // Initialize APIs axios\r\n    init: (token) => {\r\n        setToken(token)\r\n    },\r\n\r\n    auth: { ...Auth },\r\n\r\n    departments: { ...Departments },\r\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Auth.js",["175"],"import axios from \"axios\"\r\n\r\nexport default {\r\n\r\n    login: async (credentials) => {\r\n        return await axios.post('/login', credentials).then(response => response.data)\r\n    },\r\n\r\n    signup: async (credentials) => {\r\n        return await axios.post('/signup', credentials).then(response => response.data)\r\n    },\r\n\r\n    profile: async (id = null) => {\r\n        return await axios.get('/user', id)\r\n    },\r\n\r\n    logout: async () => {\r\n        return await axios.get('/logout')\r\n    }\r\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\footers\\Footer.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\dashboard\\Dashboard.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\Admin.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\navbars\\AdminNavbar.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\sidebar\\Sidebar.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardBarChart.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardLineChart.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\headers\\HeaderStats.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardStats.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\Auth.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\context\\AppContext.js",["176"],"import React, { createContext, useReducer } from \"react\";\r\nimport { useCookies } from \"react-cookie\";\r\n\r\nlet AppContext = createContext({});\r\n\r\nconst initialState = {\r\n    cookie: '',\r\n}\r\n\r\nlet reducer = (state, action) => {\r\n\r\n    switch (action.type) {\r\n        case \"setCookie\": {\r\n            return { ...state, cookie: action.cookie }\r\n        }\r\n    }\r\n\r\n    return state;\r\n};\r\n\r\nfunction AppContextProvider(props) {\r\n\r\n    const [cookies] = useCookies([\"userToken\"]);\r\n    initialState.cookie = Object.keys(cookies).length ? cookies['userToken'] : '';\r\n\r\n    const fullInitialState = {\r\n        ...initialState,\r\n    }\r\n\r\n    let [state, dispatch] = useReducer(reducer, fullInitialState);\r\n    let value = { state, dispatch };\r\n\r\n    return (\r\n        <AppContext.Provider value={value}>{props.children}</AppContext.Provider>\r\n    );\r\n}\r\n\r\nlet AppContextConsumer = AppContext.Consumer;\r\n\r\nexport { AppContext, AppContextProvider, AppContextConsumer };","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\employees\\Employees.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardEmployees.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\courses\\Courses.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardCourses.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\common\\TableHeader.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Departments.js",["177"],"import axios from 'axios';\r\n\r\nexport default {\r\n    getDepartments: () =>\r\n        axios.get(`/departments/`),\r\n    addDepartment: (department) =>\r\n        axios.post(`/departments/`, department),\r\n    updateDepartment: (department, id) =>\r\n        axios.put(`/departments/${id}`, department),\r\n    deleteDepartment: (id) =>\r\n        axios.delete(`/departments/${id}`),\r\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\departments\\CreateDepartment.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\view\\components\\Table.js",[],"C:\\dev\\SkillOpti