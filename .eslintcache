eb\\src\\reportWebVitals.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\core\\AppRouter.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\landing\\Landing.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\Navbars\\AuthNavbar.js",["143","144"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\navbars\\AuthNavbar.js",["145","146"],"import React from \"react\";\nimport { Link } from \"react-router-dom\";\n\nexport default function Navbar() {\n  return (\n    <>\n      <nav className=\"top-0 absolute z-50 w-full flex flex-wrap items-center justify-between px-2 py-3 navbar-expand-lg\">\n        <div className=\"container px-4 mx-auto flex flex-wrap items-center justify-between\">\n\n          {/* Name + Route to Home */}\n          <div className=\"w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n            <Link\n              className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n              to=\"/\"\n            >\n              Skill Optimizer\n            </Link>\n          </div>\n\n          {/* Social Logos + Login / Register Buttons */}\n          <div\n            className={\n              \"lg:flex flex-grow items-center bg-white lg:bg-transparent lg:shadow-none block rounded shadow-lg\"\n            }\n            id=\"example-navbar-warning\"\n          >\n            <ul className=\"flex flex-row list-none ml-auto\">\n\n              {/* Facebook Logo: */}\n              <li>\n                <a\n                  className=\"px-3 py-2 flex items-center\"\n                  href=\"https://www.facebook.com/\"\n                  target=\"_blank\"\n                >\n                  <i className=\"text-gray-300 fab fa-facebook text-lg leading-lg \" />\n                </a>\n              </li>\n\n              {/* Twitter Logo: */}\n              <li>\n                <a\n                  className=\"px-3 py-2 flex items-center\"\n                  href=\"https://twitter.com/\"\n                  target=\"_blank\"\n                >\n                  <i className=\"text-gray-300 fab fa-twitter text-lg leading-lg \" />\n                </a>\n              </li>\n\n              {/* Login Button: */}\n              <div className=\"pl-4 w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n                <Link\n                  className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n                  to=\"/auth\"\n                >\n                  Login\n                </Link>\n              </div>\n\n              {/* Register Button: */}\n              <div className=\"w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n                <Link\n                  className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n                  to=\"/auth/signup\"\n                >\n                  Signup\n                </Link>\n              </div>\n            </ul>\n          </div>\n        </div>\n      </nav>\n    </>\n  );\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\login\\Login.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\signup\\SignUp.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Api.js",["147"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Auth.js",["148"],"import axios from \"axios\"\r\n\r\nexport default {\r\n\r\n    login: async (credentials) => {\r\n        return await axios.post('/login', credentials).then(response => response.data)\r\n    },\r\n\r\n    signup: async (credentials) => {\r\n        return await axios.post('/signup', credentials).then(response => response.data)\r\n    },\r\n\r\n    profile: async (id = null) => {\r\n        return await axios.get('/user', id)\r\n    },\r\n\r\n    logout: asyn