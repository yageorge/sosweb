        </Link>\n          </div>\n\n          {/* Social Logos + Login / Register Buttons */}\n          <div\n            className={\n              \"lg:flex flex-grow items-center bg-white lg:bg-transparent lg:shadow-none block rounded shadow-lg\"\n            }\n            id=\"example-navbar-warning\"\n          >\n            <ul className=\"flex flex-row list-none ml-auto\">\n\n              {/* Facebook Logo: */}\n              <li>\n                <a\n                  className=\"px-3 py-2 flex items-center\"\n                  href=\"https://www.facebook.com/\"\n                  target=\"_blank\"\n                >\n                  <i className=\"text-gray-300 fab fa-facebook text-lg leading-lg \" />\n                </a>\n              </li>\n\n              {/* Twitter Logo: */}\n              <li>\n                <a\n                  className=\"px-3 py-2 flex items-center\"\n                  href=\"https://twitter.com/\"\n                  target=\"_blank\"\n                >\n                  <i className=\"text-gray-300 fab fa-twitter text-lg leading-lg \" />\n                </a>\n              </li>\n\n              {/* Login Button: */}\n              <div className=\"pl-4 w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n                <Link\n                  className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n                  to=\"/auth\"\n                >\n                  Login\n                </Link>\n              </div>\n\n              {/* Register Button: */}\n              <div className=\"w-full relative flex justify-between lg:w-auto lg:static lg:block lg:justify-start\">\n                <Link\n                  className=\"text-white text-sm font-bold leading-relaxed inline-block mr-4 py-2 whitespace-no-wrap uppercase\"\n                  to=\"/auth/signup\"\n                >\n                  Signup\n                </Link>\n              </div>\n            </ul>\n          </div>\n        </div>\n      </nav>\n    </>\n  );\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\login\\Login.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\signup\\SignUp.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Api.js",["240"],"import axios from \"axios\";\r\nimport Auth from \"./Auth\";\r\nimport Departments from \"./Departments\";\r\nimport Users from \"./User\";\r\n\r\naxios.defaults.baseURL = 'http://127.0.0.1:8000/api'\r\naxios.defaults.withCredentials = true\r\n\r\n//Adding Token to Header\r\nconst setToken = (token = null) => {\r\n    axios.defaults.headers = {\r\n        'Accept': 'application/json',\r\n        'Content-Type': 'application/json',\r\n        'Authorization': `Bearer ${token}`,\r\n    }\r\n}\r\n\r\nexport default {\r\n\r\n    // Initialize APIs axios\r\n    init: (token) => {\r\n        setToken(token)\r\n    },\r\n\r\n    auth: { ...Auth },\r\n\r\n    departments: { ...Departments },\r\n\r\n    users: { ...Users },\r\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Auth.js",["241"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\footers\\Footer.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\dashboard\\Dashboard.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\Admin.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\navbars\\AdminNavbar.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\sidebar\\Sidebar.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardBarChart.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardLineChart.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\headers\\HeaderStats.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardStats.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\Auth.js",["242"],"import React from \"react\";\r\nimport { Switch, Route, Redirect } from \"react-router-dom\";\r\n\r\nimport background from \"../../assets/img/auth_bg.png\";\r\nimport Navbar from \"../../components/navbars/AuthNavbar.js\";\r\nimport Footer from \"../../components/footers/Footer\";\r\nimport Alert from \"../../services/alert/Alert\";\r\n\r\nimport Login from \"./login/Login\";\r\nimport SignUp from \"./signup/SignUp\";\r\n\r\n//TODO move common functions / like states etc etc to this file and pass them in props / check group project\r\n\r\nexport default function Auth() {\r\n  return (\r\n    <>\r\n      <Navbar transparent />\r\n\r\n      {/* Common layout design for auth screen */}\r\n      <main>\r\n        <section className=\"relative w-full h-full py-40 min-h-screen\">\r\n          <div\r\n            className=\"absolute top-0 w-full h-full bg-gray-800 bg-no-repeat bg-full\"\r\n            style={{\r\n              backgroundImage: `url(${background})`,\r\n            }}\r\n          ></div>\r\n\r\n          {/* Rendering Login or Signup UI */}\r\n          <Switch>\r\n            <Route exact path=\"/auth/login\" component={Login} />\r\n            <Route exact path=\"/auth/signup\" component={SignUp} />\r\n            <Redirect from=\"/auth\" to=\"/auth/login\" />\r\n          </Switch>\r\n\r\n          {/* Common Footer */}\r\n          <Footer absolute />\r\n\r\n        </section>\r\n      </main>\r\n    </>\r\n  );\r\n}\r\n","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\context\\AppContext.js",["243"],"import React, { createContext, useReducer } from \"react\";\r\nimport { useCookies } from \"react-cookie\";\r\n\r\nlet AppContext = createContext({});\r\n\r\nconst initialState = {\r\n    cookie: '',\r\n}\r\n\r\nlet reducer = (state, action) => {\r\n\r\n    switch (action.type) {\r\n        case \"setCookie\": {\r\n            return { ...state, cookie: action.cookie }\r\n        }\r\n    }\r\n\r\n    return state;\r\n};\r\n\r\nfunction AppContextProvider(props) {\r\n\r\n    const [cookies] = useCookies([\"userToken\"]);\r\n    initialState.cookie = Object.keys(cookies).length ? cookies['userToken'] : '';\r\n\r\n    const fullInitialState = {\r\n        ...initialState,\r\n    }\r\n\r\n    let [state, dispatch] = useReducer(reducer, fullInitialState);\r\n    let value = { state, dispatch };\r\n\r\n    return (\r\n        <AppContext.Provider value={value}>{props.children}</AppContext.Provider>\r\n    );\r\n}\r\n\r\nlet AppContextConsumer = AppContext.Consumer;\r\n\r\nexport { AppContext, AppContextProvider, AppContextConsumer };","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardEmployees.js",[],["244","245"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\courses\\Courses.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardCourses.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\common\\TableHeader.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Departments.js",["246"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\departments\\CreateDepartment.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\view\\components\\Table.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\view\\components\\TableBody.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\view\\components\\TableHead.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\view\\Departments.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\departments\\IndexDepartments.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\alert\\Alert.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\view\\components\\TableRow.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\alert\\AlertConfirmation.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\alert\\AlertModal.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\form\\Create.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\form\\components\\Form.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\departments\\EditDepartment.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\form\\Edit.js",["247"],"import React, { useEffect, useState } from \"react\"\r\nimport { useHistory, useParams } from \"react-router-dom\";\r\n\r\nimport Api from \"../../../../services/api/Api\";\r\nimport Alert from \"../../../../services/alert/Alert\";\r\nimport TableHeader from \"../../common/TableHeader\"\r\nimport Form from \"./components/Form\";\r\n\r\nexport default function Edit() {\r\n\r\n  const history = useHistory();\r\n  const [department, setDepartment] = useState({})\r\n  const [showForm, setShowForm] = useState(false)\r\n  const [alert, setAlert] = useState('')\r\n  const [showAlert, setShowAlert] = useState(false)\r\n\r\n  //Receiving department id param to edit\r\n  const { id } = useParams();\r\n\r\n  // Get department to edit\r\n  const getDepartment = async () => {\r\n    try {\r\n\r\n      const response = await Api.departments.editDepartment(id);\r\n\r\n      if (!response.data['error']) {\r\n        setDepartment(response.data)\r\n        setShowForm(true)\r\n      } else {\r\n        setShowForm(false)\r\n        setAlert(response.data['error'])\r\n        setShowAlert(true)\r\n      }\r\n\r\n    } catch (e) {\r\n      setShowForm(false)\r\n      setAlert(e)\r\n      setShowAlert(true)\r\n    }\r\n  }\r\n\r\n  useEffect(() => {\r\n    getDepartment();\r\n  }, [])\r\n\r\n  // Capturing user input - Deparment data\r\n  const onChange = (event) => {\r\n    department[event.target.name] = event.target.value\r\n    setDepartment(department)\r\n    setShowAlert(false)\r\n  }\r\n\r\n  // Back Button onClick\r\n  const onClick = () => {\r\n    history.push(\"/admin/departments\")\r\n  }\r\n\r\n  // Update Deparment\r\n  const update = async (event) => {\r\n    //Avoid form submission / refresh\r\n    event.preventDefault()\r\n\r\n    try {\r\n\r\n      const response = await Api.departments.updateDepartment(department, department.id);\r\n\r\n      if (!response.data['error']) {\r\n\r\n        // If no errors updating, return to departments\r\n        history.push('/admin/departments');\r\n\r\n      } else {\r\n        setAlert(response.data['error'])\r\n        setShowAlert(true)\r\n      }\r\n\r\n    } catch (e) {\r\n      setAlert(e)\r\n      setShowAlert(true)\r\n    }\r\n  }\r\n\r\n  return (\r\n\r\n    <div\r\n      className=\r\n      \"relative flex flex-col min-w-0 break-words w-full mb-6 shadow-lg rounded bg-blue-900 text-white\">\r\n\r\n      {/* Creating Table header including a back button */}\r\n      <TableHeader\r\n        title=\"Edit Department\"\r\n        buttonIcon=\"fas fa-arrow-circle-left text-green-500 \"\r\n        onClick={onClick} />\r\n\r\n      {/* Only show Edit form when getDepartment is complete */}\r\n      {showForm ?\r\n        <Form\r\n          action=\"Edit\"\r\n          onChange={onChange}\r\n          submitFunction={update}\r\n          department={department} />\r\n        : null}\r\n\r\n      {/* Alert handling */}\r\n      {showAlert ?\r\n        <Alert alert={alert} />\r\n        : null}\r\n\r\n    </div>\r\n\r\n  );\r\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\User.js",["248"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\users\\IndexUsers.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\users\\view\\Users.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\users\\view\\components\\Table.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\users\\view\\components\\TableHead.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\users\\view\\components\\TableBody.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\users\\view\\components\\TableRow.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\users\\CreateUser.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\users\\EditUser.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\users\\form\\Create.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\users\\form\\Edit.js",["249"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\users\\form\\components\\Form.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\common\\SelectDepartment.js",["250"],"import React, { useEffect, useState } from 'react';\r\nimport Select from 'react-select';\r\n\r\nimport Api from \"../../../../services/api/Api\";\r\nimport AlertModal from \"../../../../services/alert/AlertModal\";\r\n\r\nexport default function SelectDepartment(props) {\r\n\r\n    const [selectDepartments, setSelectDepartments] = useState([]);\r\n\r\n    // Fetching all current company's departments + Loading Select Values\r\n    const getDepartments = async () => {\r\n        try {\r\n\r\n            const response = await Api.departments.getDepartments();\r\n            loadSelectValues(response.data);\r\n\r\n        } catch (e) {\r\n            AlertModal(\r\n                \"An error has occured: \" + e\r\n            )\r\n        }\r\n    }\r\n\r\n    // Loading departments as Select values\r\n    const loadSelectValues = async (departments) => {\r\n        const options = departments.map(department => ({\r\n\r\n            //Adding departmentId as \"name\" as another Select value, to be accepted by onChange event.target.value syntax in Create.js\r\n            \"name\": \"departmentId\",\r\n            \"value\": department.id,\r\n            \"label\": department.name.toUpperCase()\r\n        }))\r\n        setSelectDepartments(options)\r\n    }\r\n\r\n    useEffect(() => {\r\n        // Fetching Departments\r\n        getDepartments()\r\n    }, []);\r\n\r\n\r\n    return (\r\n        <div className=\"relative w-full mb-3\">\r\n            <label\r\n                className=\"block uppercase text-gray-500 text-xs font-bold mb-2\"\r\n            >\r\n                Departments\r\n            </label>\r\n\r\n            {/* Dropdown departments select option */}\r\n            <Select\r\n                className=\"text-gray-900\"\r\n                options={selectDepartments}\r\n\r\n                // wrapping event with a target object, to be accepted by onChange event.target.value syntax in Create.js\r\n                onChange={event => props.onChange({ target: event })}\r\n            />\r\n        </div>\r\n    );\r\n\r\n};","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\common\\UserInput.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\departments\\common\\CheckBox.js",["251","252"],{"ruleId":"253","replacedBy":"254"},{"ruleId":"255","replacedBy":"256"},{"ruleId":"257","severity":1,"message":"258","line":34,"column":19,"nodeType":"259","endLine":34,"endColumn":34},{"ruleId":"257","severity":1,"message":"258","line":45,"column":19,"nodeType":"259","endLine":45,"endColumn":34},{"ruleId":"257","severity":1,"message":"258","line":34,"column":19,"nodeType":"259","endLine":34,"endColumn":34},{"ruleId":"257","severity":1,"message":"258","line":45,"column":19,"nodeType":"259","endLine":45,"endColumn":34},{"ruleId":"260","severity":1,"message":"261","line":18,"column":1,"nodeType":"262","endLine":30,"endColumn":2},{"ruleId":"260","severity":1,"message":"261","line":3,"column":1,"nodeType":"262","endLine":17,"endColumn":2},{"ruleId":"263","severity":1,"message":"264","line":7,"column":8,"nodeType":"265","messageId":"266","endLine":7,"endColumn":13},{"ruleId":"267","severity":1,"message":"268","line":12,"column":5,"nodeType":"269","messageId":"270","endLine":