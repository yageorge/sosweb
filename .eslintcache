n) => {\r\n        setToken(token)\r\n    },\r\n\r\n    auth: { ...Auth },\r\n\r\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\api\\Auth.js",["153"],"import axios from \"axios\"\r\n\r\nexport default {\r\n\r\n    login: async (credentials) => {\r\n        return await axios.post('/login', credentials).then(response => response.data)\r\n    },\r\n\r\n    signup: async (credentials) => {\r\n        return await axios.post('/signup', credentials).then(response => response.data)\r\n    },\r\n\r\n    profile: async (id = null) => {\r\n        return await axios.get('/user', id)\r\n    },\r\n\r\n    logout: async () => {\r\n        return await axios.get('/logout')\r\n    }\r\n}","C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\footers\\Footer.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\dashboard\\Dashboard.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\Admin.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\navbars\\AdminNavbar.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\sidebar\\Sidebar.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardBarChart.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardLineChart.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\headers\\HeaderStats.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardStats.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\auth\\Auth.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\services\\context\\AppContext.js",["154"],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\views\\admin\\employees\\Employees.js",[],"C:\\dev\\SkillOptimizerSolution\\sosweb\\src\\components\\cards\\CardEmployees.js",["155"],"import React from \"react\";\n\nexport default function CardDepartments() {\n  return (\n    <>\n      <div\n        className=\n        \"relative flex flex-col min-w-0 break-words w-full mb-6 shadow-